# SpendWise Server Environment Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Reverse Proxy Configuration (Render / PaaS)
# Number of reverse proxy hops to trust (e.g. 1 for Render). Defaults to 1 in production mode.
TRUST_PROXY=1

# Database Connection (Neon PostgreSQL URL format - placeholder for later stage)
DATABASE_URL=postgresql://neondb_owner:your_password_here@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Session Authentication
SESSION_SECRET=your_secure_random_hex_string_at_least_32_characters_long
SESSION_MAX_AGE_MS=604800000

# Application Settings
DEFAULT_CURRENCY=INR
