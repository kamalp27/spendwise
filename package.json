{
  "name": "spendwise",
  "version": "1.0.0",
  "description": "SpendWise - Personal Expense Tracker",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "client": "npm run dev --workspace=client",
    "server": "npm run dev --workspace=server",
    "build:client": "npm run build --workspace=client",
    "db:migrate": "npm run migrate --workspace=server",
    "db:seed": "npm run seed --workspace=server",
    "test:server": "npm run test --workspace=server",
    "test:client": "npm run test --workspace=client",
    "test": "npm run test:server"
  },
  "keywords": [
    "expense-tracker",
    "react",
    "vite",
    "express",
    "postgresql",
    "full-stack"
  ],
  "author": "Kamal Patil",
  "license": "ISC"
}
